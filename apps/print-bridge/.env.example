# Address of the AMMAS server (cloud URL, or http://localhost:4000 in development)
SERVER_URL=http://localhost:4000
# Must equal PRINT_BRIDGE_TOKEN on the server (16+ characters)
BRIDGE_TOKEN=

# How this computer reaches the printer: TCP (Ethernet), FILE (USB share / device path) or DRYRUN (prints to this console)
PRINTER_MODE=DRYRUN
# TCP mode: printer IP and port (most ESC/POS printers use 9100)
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
# FILE mode: Linux "/dev/usb/lp0"  |  Windows shared printer "\\\\localhost\\BluPrintsUtkarsh"
PRINTER_PATH=

# Characters per line - must match the receipt width set in the app (58mm is usually 32, 80mm is usually 42 or 48)
POLL_MS=1500
CUT_PAPER=1
